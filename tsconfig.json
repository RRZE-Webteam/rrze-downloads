{
	"compilerOptions": {
		"noImplicitAny": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"target": "es2020",
		"lib": [ "dom", "es2020" ],
		"skipLibCheck": true
	},
	"include": [ "./src/**/*" ]
}
