{
  "title": "RRZE Downloads",
  "name": "rrze-downloads",
  "version": "2.3.0",
  "description": "RRZE Downloads: Manage Categories for the WP Media Library",
  "main": "rrze-downloads.php",
  "textdomain": "rrze-downloads",
  "domainPath": "/languages",
  "private": true,
  "source": {
    "js": "./src/js/",
    "adminJs": "./src/js/admin/",
    "sass": "./src/scss/"
  },
  "target": {
    "js": "./build/js/",
    "css": "./build/css/"
  },
  "scripts": {
    "readme": "node scripts/build-readme.js",
    "version:dev": "node scripts/build-version.js dev",
    "version:prod": "node scripts/build-version.js prod",
    "version:release": "node scripts/build-version.js release",
    "build:assets": "node scripts/build-assets.js dev",
    "build:assets:dev": "node scripts/build-assets.js dev",
    "build:assets:prod": "node scripts/build-assets.js prod",
    "watch:assets": "node scripts/build-assets.js dev --watch",
    "start": "npm run watch:assets",
    "dev": "npm run build:assets:dev && npm run version:dev && npm run build:wp && npm run readme",
    "build": "npm run build:assets:dev && npm run version:prod && npm run build:wp && npm run readme",
    "prod": "npm run build:assets:prod && npm run version:prod && npm run build:wp && npm run readme",
    "release": "npm run build:assets:prod && npm run version:release && npm run build:wp && npm run readme",
    "build:wp": "wp-scripts build",
    "format": "wp-scripts format",
    "start:wp": "wp-scripts start"
  },
  "compatibility": {
    "wprequires": "6.8",
    "wptestedup": "7.1",
    "phprequires": "8.2"
  },
  "supports": {
    "email": "webmaster@fau.de"
  },
  "author": {
    "name": "RRZE Webteam (webmaster@fau.de)",
    "url": "https://www.wp.rrze.fau.de/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RRZE-Webteam/rrze-downloads",
    "issues": "https://github.com/RRZE-Webteam/rrze-downloads/issues",
    "clone": "git+https://github.com/RRZE-Webteam/rrze-downloads.git"
  },
  "license": "GNU General Public License Version 3",
  "licenseurl": "https://www.gnu.org/licenses/gpl-3.0.html",
  "tags": "Plugin, WordPress, Multisite, RRZE, FAU, Access Control",
  "devDependencies": {
    "@types/wordpress__block-editor": "^15.0.6",
    "@wordpress/components": "^40.1.0",
    "@wordpress/scripts": "^35.0.0",
    "@wordpress/server-side-render": "^6.31.0",
    "sass": "^1.104.0",
    "terser": "^5.51.2",
    "typescript": "^6.0.0"
  }
}
